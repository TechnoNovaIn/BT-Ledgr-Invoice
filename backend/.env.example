DATABASE_URL="postgresql://invoice_user:yourpassword@localhost:5432/invoice_db"

PORT=4000
NODE_ENV=development

# Upload config
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/webp

# Ollama settings are IGNORED — extraction is fully offline (regex + local OCR).
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5-coder:7b

# Fuzzy match thresholds (0-1)
VENDOR_MATCH_THRESHOLD=0.75
AMOUNT_TOLERANCE_PERCENT=0.01
